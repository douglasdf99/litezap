---
// Uma página da referência por tag do OpenAPI (public/openapi.yaml).
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code } from '@astrojs/starlight/components';
import { tags, md, examples, fields, curl, scopeLabel, schemaType, type Tag } from '../../../lib/openapi';

export function getStaticPaths() {
	return tags().map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}

const { tag } = Astro.props as { tag: Tag };
const headings = tag.operations.map((op) => ({ depth: 2, slug: op.id, text: op.summary }));
const json = (v: unknown) => JSON.stringify(v, null, 2);
const ok = (code: string) => code.startsWith('2');
---

<StarlightPage
	frontmatter={{
		title: tag.name,
		description: tag.description,
		editUrl: false,
	}}
	headings={headings}
>
	<Fragment set:html={md(tag.description)} />
	<p>
		Gerado de <a href="/openapi.yaml">openapi.yaml</a>. Convenções gerais (autenticação, erros, paginação,
		idempotência, <code>?wait</code> e limites) estão na <a href="/docs/api/">visão geral</a>.
	</p>

	{
		tag.operations.map((op) => {
			const media = op.requestBody?.content?.['application/json'];
			const reqExamples = examples(media);
			const bodyFields = fields(media?.schema);
			const params = op.parameters.filter((p) => p.in === 'path' || p.in === 'query');
			return (
				<section class="lz-op">
					<h2 id={op.id}>{op.summary}</h2>
					<div class="lz-endpoint">
						<span class={`lz-method lz-method--${op.method}`}>{op.method.toUpperCase()}</span>
						<code>{op.path}</code>
						<span class={`lz-scope lz-scope--${op.scope}`}>{scopeLabel[op.scope] ?? op.scope}</span>
					</div>
					<Fragment set:html={md(op.description)} />

					{params.length > 0 && (
						<>
							<h3>Parâmetros</h3>
							<table class="lz-table">
								<thead>
									<tr>
										<th>Nome</th>
										<th>Em</th>
										<th>Descrição</th>
									</tr>
								</thead>
								<tbody>
									{params.map((p) => (
										<tr>
											<td>
												<code>{p.name}</code>
												{p.required && <span class="lz-req">obrigatório</span>}
											</td>
											<td>{p.in === 'path' ? 'caminho' : 'query'}</td>
											<td set:html={md(p.description)} />
										</tr>
									))}
								</tbody>
							</table>
						</>
					)}

					{bodyFields.length > 0 && (
						<>
							<h3>Corpo</h3>
							<table class="lz-table">
								<thead>
									<tr>
										<th>Campo</th>
										<th>Tipo</th>
										<th>Descrição</th>
									</tr>
								</thead>
								<tbody>
									{bodyFields.map((f) => (
										<tr>
											<td>
												<code>{f.name}</code>
												{f.required && <span class="lz-req">obrigatório</span>}
											</td>
											<td>
												<code>{f.type}</code>
											</td>
											<td set:html={md(f.description)} />
										</tr>
									))}
								</tbody>
							</table>
						</>
					)}

					<h3>Exemplo</h3>
					<Code code={curl(op, reqExamples[0]?.value)} lang="bash" />
					{reqExamples.slice(1).map((ex) => (
						<Code code={json(ex.value)} lang="json" title={`Corpo: ${ex.name}`} />
					))}

					<h3>Respostas</h3>
					{op.responses.map(([code, r]) => {
						const content = r.content ?? {};
						const exs = Object.values<any>(content).flatMap((m) => examples(m));
						const types = Object.keys(content).filter((t) => t !== 'application/json');
						const schema = content['application/json']?.schema;
						return (
							<div>
								<p>
									<span class={`lz-status ${ok(code) ? 'lz-status--ok' : 'lz-status--err'}`}>{code}</span>{' '}
									<Fragment set:html={md(r.description).replace(/^<p>|<\/p>$/g, '')} />
									{ok(code) && schema && (
										<>
											{' '}
											(<code>{schemaType(schema)}</code>)
										</>
									)}
									{types.length > 0 && <> · também {types.map((t) => <code>{t}</code>)}</>}
								</p>
								{ok(code) && exs.map((ex) => <Code code={json(ex.value)} lang="json" title={ex.name} />)}
							</div>
						);
					})}
				</section>
			);
		})
	}
</StarlightPage>
