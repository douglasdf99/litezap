---
import { Code } from 'astro:components';
import { Image } from 'astro:assets';
import Architecture from '../components/Architecture.astro';
import Icon from '../components/Icon.astro';
import logoFull from '../assets/brand/logo-full.png';
import logoWhite from '../assets/brand/logo-full-white.png';
import '../styles/tokens.css';

const GITHUB = 'https://github.com/douglasdf99/litezap';
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const FONTS =
	'https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,300..800;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap';

const features = [
	{ icon: 'layers', title: 'Várias instâncias', text: 'Um número de WhatsApp por instância, cada uma com token próprio. Crie, pare, reinicie e apague pela API.' },
	{ icon: 'qr', title: 'QR ou código por telefone', text: 'Pareie escaneando o QR (JSON ou PNG) ou digitando no celular um código gerado pela API.' },
	{ icon: 'refresh', title: 'Supervisor com auto-restart', text: 'Cada número roda num processo isolado. Heartbeat a cada 10s, restart com backoff e circuit breaker. Crash de um worker não derruba os outros.' },
	{ icon: 'message', title: 'Envio e recebimento', text: 'Fila persistente por instância, modo síncrono com ?wait=true, idempotência por client_message_id, chats, histórico e confirmações de leitura.' },
	{ icon: 'image', title: 'Mídia', text: 'Imagem, vídeo, áudio (inclusive mensagem de voz), documento e reações. Mídia recebida sob demanda, com URLs assinadas temporárias.' },
	{ icon: 'shield', title: 'Anti-ban por padrão', text: 'Ritmo com variação aleatória, rampa para números novos, janela de envio para contatos frios e verificação do número antes do primeiro envio.' },
	{ icon: 'globe', title: 'Proxy por instância', text: 'HTTP, HTTPS ou SOCKS5 por número, fixo durante a sessão. Se o proxy cai, a instância espera: nunca vaza pela conexão direta.' },
	{ icon: 'webhook', title: 'Webhooks e SSE', text: 'Eventos com envelope único, assinados com HMAC, retry por 24h e dead-letter, além de streams SSE ao vivo.' },
	{ icon: 'sparkles', title: 'MCP para IA', text: 'Claude, ChatGPT e outros clientes leem conversas e enviam mensagens pelo servidor MCP, sempre pela mesma fila anti-ban. Atendente automático (hook de agente) em breve.' },
] as const;

const modes = [
	{ icon: 'laptop', title: 'No seu PC', text: 'App de bandeja com painel web: pareie, converse e configure sem terminal. Seu IP residencial, API só em localhost.', tag: 'Disponível', note: 'instaladores em breve', href: '/docs/app-local/' },
	{ icon: 'server', title: 'No seu servidor', text: 'VPS ou servidor próprio com Docker ou systemd, atrás de um proxy reverso com TLS.', tag: 'Disponível', href: '/docs/self-hosted/' },
	{ icon: 'cloud', title: 'Na nuvem LiteZap', text: 'Um projeto pré-instalado só seu, com upgrades, backups, monitoramento e IPs gerenciados.', tag: 'Em breve', soon: true, href: '#precos' },
] as const;

// Amplitude de recursos, agrupada como a matriz de paridade. true = disponível; string = marco.
const breadth: { group: string; href: string; items: [string, true | string][] }[] = [
	{
		group: 'Mensagens',
		href: '/docs/api/mensagens/tipos/',
		items: [
			['Texto, imagem, vídeo, documento', true],
			['Áudio e mensagem de voz', true],
			['Reações', true],
			['Fila, ritmo e idempotência', true],
			['Figurinha, GIF, localização, contato', 'M6'],
			['Responder citando e menções', 'M6'],
			['Editar, apagar, fixar, encaminhar', 'M6'],
			['Enquetes com votos', 'M6'],
			['Botões e listas', 'Exp'],
		],
	},
	{
		group: 'Eventos',
		href: '/docs/eventos/',
		items: [
			['Webhooks assinados (HMAC)', true],
			['Streams SSE', true],
			['Status de entrega e leitura', true],
			['Retry de 24h e dead-letter', true],
			['Presença, apagadas e editadas', 'M7'],
			['Chamadas e rejeição automática', 'M7'],
		],
	},
	{
		group: 'Grupos',
		href: '/docs/guias/grupos/',
		items: [
			['Enviar e receber em grupos', true],
			['Criar e administrar grupos', 'M8'],
			['Participantes, admins e convites', 'M8'],
			['Comunidades', 'M8'],
		],
	},
	{
		group: 'Chats e contatos',
		href: '/docs/api/chats/',
		items: [
			['Chats e histórico com cursor', true],
			['Marcar como lido', true],
			['Contatos e verificação de números', true],
			['Arquivar, fixar, silenciar', 'M9'],
			['Foto de perfil e bloqueio', 'M9'],
		],
	},
	{
		group: 'Perfil',
		href: '/docs/api/em-breve/perfil-e-privacidade/',
		items: [
			['Nome, recado e foto', 'M9'],
			['Privacidade', 'M9'],
		],
	},
	{
		group: 'Business e canais',
		href: '/docs/api/business/',
		items: [
			['Status (stories)', true],
			['Canais', true],
			['Etiquetas e perfil comercial', true],
		],
	},
	{
		group: 'Plataforma',
		href: '/docs/self-hosted/',
		items: [
			['Multi-instância com token por número', true],
			['Proxy por instância', true],
			['Docker, systemd, app local', true],
			['MCP para Claude e outros', true],
			['Atendente IA (hook de agente)', 'M5'],
			['Pareamento hospedado para parceiros', true],
		],
	},
];

const comparison: [string, string, string][] = [
	['Código-fonte', 'Aberto, Apache-2.0', 'Fechado'],
	['Onde roda', 'Seu PC, seu servidor ou nuvem LiteZap', 'Só na nuvem do fornecedor'],
	['Seus dados', 'Na sua pasta data/, sob seu controle', 'Nos servidores do fornecedor'],
	['Trocar de hospedagem', 'Mesma API; copie a pasta de dados', 'Reescrever a integração'],
	['Anti-ban', 'Ritmo, rampa e janela configuráveis e auditáveis', 'Regras opacas'],
	['Eventos', 'Webhooks assinados, retry de 24h, dead-letter e SSE', 'Varia; assinatura e reenvio nem sempre existem'],
	['Custo', 'Grátis no self-host; nuvem opcional', 'Mensalidade por instância'],
];

const samples = [
	{
		id: 'curl',
		label: 'cURL',
		lang: 'bash',
		code: `curl -X POST "localhost:8787/v1/instances/$ID/messages?wait=true" \\
  -H "Authorization: Bearer $TOK" \\
  -d '{
    "to": "5511999999999",
    "type": "text",
    "text": "Seu pedido saiu para entrega!",
    "client_message_id": "pedido-123"
  }'`,
	},
	{
		id: 'js',
		label: 'JavaScript',
		lang: 'js',
		code: `const res = await fetch(
  \`http://localhost:8787/v1/instances/\${id}/messages?wait=true\`,
  {
    method: "POST",
    headers: { Authorization: \`Bearer \${token}\` },
    body: JSON.stringify({
      to: "5511999999999",
      type: "text",
      text: "Seu pedido saiu para entrega!",
      client_message_id: "pedido-123",
    }),
  },
);
const msg = await res.json(); // { id, status: "sent", wa_message_id }`,
	},
	{
		id: 'py',
		label: 'Python',
		lang: 'python',
		code: `import requests

r = requests.post(
    f"http://localhost:8787/v1/instances/{instance_id}/messages",
    params={"wait": "true"},
    headers={"Authorization": f"Bearer {token}"},
    json={
        "to": "5511999999999",
        "type": "text",
        "text": "Seu pedido saiu para entrega!",
        "client_message_id": "pedido-123",
    },
)
print(r.json()["status"])  # "sent"`,
	},
	{
		id: 'res',
		label: 'Resposta',
		lang: 'json',
		code: `HTTP/1.1 200 OK

{
  "id": "msg_a41c9e07d2b35f68",
  "client_message_id": "pedido-123",
  "wa_message_id": "3EB0A1B2C3D4E5F6A7B8C9",
  "chat": "5511999999999@s.whatsapp.net",
  "from_me": true,
  "type": "text",
  "status": "sent"
}`,
	},
];
---

<!doctype html>
<html lang="pt-BR" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>LiteZap · API de WhatsApp open source, local ou na nuvem</title>
		<meta
			name="description"
			content="LiteZap é uma API de WhatsApp não oficial e open source (Apache-2.0). O mesmo binário roda no seu PC, no seu servidor ou na nuvem gerenciada."
		/>
		<meta name="theme-color" content="#377AFB" />
		<meta property="og:title" content="LiteZap · API de WhatsApp open source" />
		<meta property="og:description" content="O mesmo binário no seu PC, no seu servidor ou na nuvem." />
		<meta property="og:image" content={`${site}/og.png`} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" href="/favicon.png" type="image/png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href={FONTS} />
		<script is:inline>
			// Mesmo armazenamento do Starlight ("starlight-theme": light | dark | vazio = automático).
			(() => {
				let t = '';
				try {
					t = localStorage.getItem('starlight-theme') || '';
				} catch {}
				if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
				document.documentElement.dataset.theme = t;
			})();
		</script>
	</head>
	<body>
		<header class="nav">
			<div class="wrap nav-inner">
				<a href="/" class="brand" aria-label="LiteZap, início">
					<Image src={logoFull} alt="LiteZap" height={30} class="logo logo-light" loading="eager" />
					<Image src={logoWhite} alt="LiteZap" height={30} class="logo logo-dark" loading="eager" />
				</a>
				<nav class="links">
					<a href="/docs/">Documentação</a>
					<a href="/docs/api/">API</a>
					<a href="/docs/self-hosted/">Self-hosted</a>
					<a href="#precos">Preços</a>
					<a href="/docs/roadmap/">Roadmap</a>
				</nav>
				<div class="nav-actions">
					<button class="icon-btn" id="theme-toggle" type="button" aria-label="Alternar tema claro/escuro">
						<span class="i-sun"><Icon name="sun" size={18} /></span>
						<span class="i-moon"><Icon name="moon" size={18} /></span>
					</button>
					<a class="btn btn-ghost btn-sm hide-sm" href={GITHUB}><Icon name="github" size={16} /> GitHub</a>
					<a class="btn btn-primary btn-sm" href="/docs/quickstart/">Começar</a>
				</div>
			</div>
		</header>

		<main>
			<section class="hero">
				<div class="hero-bg" aria-hidden="true"></div>
				<div class="wrap hero-inner">
					<a class="pill" href="/docs/roadmap/">
						<span class="pill-dot"></span> Open source · Apache-2.0 · Webhooks e SSE disponíveis
						<Icon name="arrow" size={14} />
					</a>
					<h1>
						A API de WhatsApp que roda <br /><span class="grad">onde você quiser</span>
					</h1>
					<p class="lead">
						O mesmo binário no seu computador, no seu servidor ou na nuvem gerenciada. Um processo por número,
						supervisionado, com uma fila que respeita o ritmo de um humano.
					</p>
					<div class="ctas">
						<a class="btn btn-primary btn-lg" href="/docs/baixar/">Baixar o app e usar no Claude</a>
						<a class="btn btn-ghost btn-lg" href="/docs/quickstart/">Primeira mensagem em 5 minutos</a>
						<a class="btn btn-ghost btn-lg" href={GITHUB}><Icon name="github" size={18} /> Ver no GitHub</a>
					</div>
					<p class="fine">Não oficial. Sem afiliação com o WhatsApp ou a Meta.</p>

					<div class="window" role="region" aria-label="Exemplo de envio de mensagem">
						{samples.map((s, i) => <input type="radio" name="sample" id={`tab-${s.id}`} checked={i === 0} />)}
						<div class="window-bar">
							<span class="dots"><i></i><i></i><i></i></span>
							<div class="tabs">
								{samples.map((s) => <label for={`tab-${s.id}`}>{s.label}</label>)}
							</div>
							<span class="window-path">POST /v1/instances/{'{id}'}/messages</span>
						</div>
						{
							samples.map((s) => (
								<div class={`pane pane-${s.id}`}>
									<Code code={s.code} lang={s.lang as any} theme="github-dark-default" />
								</div>
							))
						}
					</div>
				</div>
			</section>

			<section class="wrap section" id="modos">
				<p class="eyebrow">Distribuição</p>
				<h2>Um motor, três formas de rodar</h2>
				<p class="section-lead">Comece no seu computador e leve para um servidor sem mudar uma linha da sua integração.</p>
				<div class="modes">
					{
						modes.map((m) => (
							<a class="mode" href={m.href}>
								<span class="icon-box"><Icon name={m.icon} size={22} /></span>
								<h3>{m.title}</h3>
								<p>{m.text}</p>
								<span class:list={['tag', { soon: 'soon' in m }]}>{m.tag}</span>
								{'note' in m && <span class="note">{m.note}</span>}
							</a>
						))
					}
				</div>
			</section>

			<section class="wrap section" id="recursos">
				<p class="eyebrow">Recursos</p>
				<h2>Tudo o que uma integração séria precisa</h2>
				<p class="section-lead">Recursos no nível das APIs de WhatsApp comerciais, num motor que você pode ler, rodar e auditar.</p>
				<div class="grid">
					{
						features.map((f) => (
							<article class="card">
								<span class="icon-box"><Icon name={f.icon} size={20} /></span>
								<h3>
									{f.title} {'soon' in f && <span class="tag soon">Em breve</span>}
								</h3>
								<p>{f.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="wrap section" id="amplitude">
				<p class="eyebrow">Amplitude</p>
				<h2>O que já existe e o que vem a seguir</h2>
				<p class="section-lead">
					Cada recurso planejado tem marco definido e página na documentação. Nada é anunciado como disponível antes de
					existir.
				</p>
				<div class="breadth">
					{
						breadth.map((g) => (
							<a class="breadth-card" href={g.href}>
								<h3>{g.group}</h3>
								<ul>
									{g.items.map(([label, st]) => (
										<li>
											<span>{label}</span>
											{st === true ? (
												<span class="tag">Disponível</span>
											) : st === 'Exp' ? (
												<span class="tag exp">Experimental</span>
											) : (
												<span class="tag soon">Em breve · {st}</span>
											)}
										</li>
									))}
								</ul>
							</a>
						))
					}
				</div>
				<p class="breadth-foot">
					<a class="link-arrow" href="/docs/roadmap/">Ver o roadmap completo <Icon name="arrow" size={16} /></a>
					<a class="link-arrow" href="/docs/migrar-da-z-api/">Migrar de outra API <Icon name="arrow" size={16} /></a>
				</p>
			</section>

			<section class="wrap section" id="comparativo">
				<p class="eyebrow">Por que open source</p>
				<h2>LiteZap vs APIs proprietárias</h2>
				<p class="section-lead">Os mesmos recursos que você espera de uma API comercial, sem abrir mão do controle.</p>
				<div class="compare">
					<div class="compare-row compare-head">
						<span></span>
						<span class="compare-us">LiteZap</span>
						<span>API proprietária típica</span>
					</div>
					{
						comparison.map(([k, us, them]) => (
							<div class="compare-row">
								<span class="compare-k">{k}</span>
								<span class="compare-us">
									<Icon name="check" size={16} /> {us}
								</span>
								<span class="compare-them">{them}</span>
							</div>
						))
					}
				</div>
			</section>

			<section class="wrap section">
				<div class="arch">
					<div>
						<p class="eyebrow">Arquitetura</p>
						<h2>Um supervisor, um worker por número</h2>
						<p class="muted">
							<code>litezap serve</code> expõe a API REST, guarda tudo num SQLite local e cuida da fila de envio. Cada
							número conectado ganha seu próprio processo <code>litezap worker</code>, falando com o supervisor por
							gRPC num socket local.
						</p>
						<ul class="checks">
							<li><Icon name="check" size={18} /> Se um worker trava ou morre, só aquele número reconecta, sem novo QR.</li>
							<li><Icon name="check" size={18} /> Se o supervisor morre, os workers encerram sozinhos: nada de processo órfão.</li>
							<li><Icon name="check" size={18} /> Mensagens na fila sobrevivem a restarts e saem quando o número volta.</li>
						</ul>
						<a class="link-arrow" href="/docs/conceitos/instancias/">Como funcionam as instâncias <Icon name="arrow" size={16} /></a>
					</div>
					<div class="arch-panel"><Architecture /></div>
				</div>
			</section>

			<section class="wrap section" id="precos">
				<p class="eyebrow">Preços</p>
				<h2>Grátis para rodar. Nuvem quando você quiser.</h2>
				<div class="plans">
					<div class="plan">
						<h3>Self-hosted</h3>
						<p class="price">Grátis</p>
						<p class="muted">Para sempre, Apache-2.0. Rode quantas instâncias o seu hardware aguentar.</p>
						<ul class="checks small">
							<li><Icon name="check" size={16} /> Todos os recursos do motor</li>
							<li><Icon name="check" size={16} /> No seu PC ou no seu servidor</li>
							<li><Icon name="check" size={16} /> Código aberto e auditável</li>
						</ul>
						<a class="btn btn-ghost" href="/docs/self-hosted/">Instalar</a>
					</div>
					<div class="plan plan-featured">
						<span class="tag soon plan-tag">Em breve</span>
						<h3>Nuvem LiteZap</h3>
						<p class="price">Em breve</p>
						<p class="muted">Projeto pré-instalado por cliente, com cobrança mensal por instância.</p>
						<ul class="checks small">
							<li><Icon name="check" size={16} /> IP de saída isolado por cliente</li>
							<li><Icon name="check" size={16} /> Backups e upgrades gerenciados</li>
							<li><Icon name="check" size={16} /> O mesmo binário open source</li>
						</ul>
						<a class="btn btn-primary" href="/docs/roadmap/">Ver roadmap</a>
					</div>
				</div>
			</section>

			<section class="wrap section">
				<div class="cta">
					<h2>Conecte seu primeiro número hoje</h2>
					<p>Compile, suba o servidor e envie a primeira mensagem em poucos minutos.</p>
					<div class="ctas center">
						<a class="btn btn-white btn-lg" href="/docs/quickstart/">Ler o quickstart</a>
						<a class="btn btn-outline-white btn-lg" href="/docs/api/">Referência da API</a>
					</div>
				</div>
			</section>
		</main>

		<footer class="footer">
			<div class="wrap footer-grid">
				<div>
					<Image src={logoFull} alt="LiteZap" height={26} class="logo logo-light" />
					<Image src={logoWhite} alt="LiteZap" height={26} class="logo logo-dark" />
					<p class="muted small-text">API de WhatsApp open source. Projeto independente, não afiliado ao WhatsApp ou à Meta.</p>
				</div>
				<div>
					<h4>Produto</h4>
					<a href="#recursos">Recursos</a>
					<a href="#precos">Preços</a>
					<a href="/docs/roadmap/">Roadmap</a>
				</div>
				<div>
					<h4>Documentação</h4>
					<a href="/docs/quickstart/">Quickstart</a>
					<a href="/docs/api/">Referência da API</a>
					<a href="/docs/boas-praticas/">Boas práticas</a>
				</div>
				<div>
					<h4>Projeto</h4>
					<a href={GITHUB}>GitHub</a>
					<a href="/openapi.yaml">OpenAPI</a>
					<a href={`${GITHUB}/blob/main/LICENSE`}>Licença Apache-2.0</a>
				</div>
			</div>
		</footer>

		<script is:inline>
			document.getElementById('theme-toggle')?.addEventListener('click', () => {
				const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
				document.documentElement.dataset.theme = next;
				try {
					localStorage.setItem('starlight-theme', next);
				} catch {}
			});
		</script>
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
	}
	html {
		scroll-behavior: smooth;
		scroll-padding-top: 80px;
	}
	body {
		margin: 0;
		background: var(--lz-bg);
		color: var(--lz-text);
		font-family: var(--lz-font);
		font-size: 16px;
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
	}
	a {
		color: var(--lz-link);
		text-decoration: none;
	}
	code {
		font-family: var(--lz-font-mono);
	}
	.wrap {
		max-width: 1160px;
		margin: 0 auto;
		padding: 0 16px;
	}
	@media (min-width: 640px) {
		.wrap {
			padding: 0 24px;
		}
	}
	.muted {
		color: var(--lz-text-muted);
	}

	/* Logo claro/escuro */
	.logo {
		width: auto;
		display: block;
	}
	:root[data-theme='dark'] .logo-light,
	:root[data-theme='light'] .logo-dark {
		display: none;
	}

	/* Navegação */
	.nav {
		position: sticky;
		top: 0;
